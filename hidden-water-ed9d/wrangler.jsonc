/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hidden-water-ed9d",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-02",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Slip verification is OFF for now — orders go straight to LINE OA with manual payment.
	// Flip to "true" (and set EASYSLIP_API_KEY + PROMPTPAY_ACCOUNT secrets) to enable EasySlip checks.
	"vars": {
		"SLIP_VERIFICATION_ENABLED": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "product-db",
			"database_id": "192bb2a5-3800-4e9f-92b0-928ade3b2b62"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "product-images"
		},
		{
			"binding": "WEB_UTILS",
			"bucket_name": "web-utils"
		},
		{
			"binding": "KIT_IMAGE",
			"bucket_name": "kit-image"
		},
		{
			"binding": "SLIPS",
			"bucket_name": "order-slips"
		}
	],
	"ai": {
		"binding": "AI"
	}
}